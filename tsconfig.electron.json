{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-electron",
    "rootDir": ".",
    "lib": ["ES2023"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "electron"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["electron/**/*.ts", "src/lib/questionPatterns.ts"]
}
