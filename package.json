{
  "name": "ytpdf",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "desktop": "npm run electron:dev",
    "build": "tsc -b && vite build",
    "build:renderer": "tsc -b && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "electron:dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 file:dist-electron/electron/main.js && cross-env ELECTRON_DISABLE_SECURITY_WARNINGS=1 VITE_DEV_SERVER_URL=http://localhost:5173 electron dist-electron/electron/main.js\"",
    "electron:build": "npm run build:renderer && npm run build:electron",
    "lint": "eslint .",
    "test": "npm run build:electron && node --test dist-electron/electron/jobs/binaries.test.js dist-electron/electron/jobs/filters.test.js dist-electron/electron/jobs/store.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^38.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "wait-on": "^9.0.3"
  }
}
